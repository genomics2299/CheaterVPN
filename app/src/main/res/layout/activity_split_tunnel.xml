<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/split_tunnel_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/split_tunnel_hint"
                android:textSize="13sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="6dp" />

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <RadioButton
                    android:id="@+id/radioExclude"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:minWidth="0dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/split_tunnel_exclude"
                    android:textAllCaps="true"
                    android:textSize="13sp"
                    android:textColor="@color/btn_toggle_text"
                    android:background="@drawable/bg_toggle_pill" />

                <RadioButton
                    android:id="@+id/radioInclude"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:minWidth="0dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/split_tunnel_include"
                    android:textAllCaps="true"
                    android:textSize="13sp"
                    android:textColor="@color/btn_toggle_text"
                    android:background="@drawable/bg_toggle_pill" />
            </RadioGroup>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/split_tunnel_search"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:autofillHints=""
                android:singleLine="true"
                android:maxLines="1"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <ImageView
        android:id="@+id/btnBackToMain"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="35dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/split_tunnel_back"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back" />

</LinearLayout>
